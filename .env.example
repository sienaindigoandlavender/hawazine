# --- Email (Resend) ---
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional overrides for the contact + newsletter destination addresses.
# Defaults (set in app/api/contact/route.ts): TO=morocco@hawazine.com,
# FROM=noreply@hawazine.com. FROM must be a verified Resend sender on a
# domain you have authenticated in Resend; override here if using a
# different domain.
# CONTACT_EMAIL_TO=
# CONTACT_EMAIL_FROM=

# --- Maps (Mapbox) ---
# Public token from https://account.mapbox.com/access-tokens — used by
# the QuarterMap component on /marrakech/[quarter] pages. Restrict the
# token to the hawazine.com domain in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Images (Cloudinary) ---
# Only the cloud name is needed at render time. Image URLs are hardcoded
# into lib/content/*.ts and pulled from https://res.cloudinary.com/<cloud>/...
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Site ---
# Used by sitemap.ts, robots.ts, canonical URLs, and Open Graph tags.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://hawazine.com

# --- Analytics (Google Analytics 4) ---
# GA4 Measurement ID from https://analytics.google.com (Admin → Data streams).
# Format: G-XXXXXXXXXX. Leave blank to disable analytics in dev/preview.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
